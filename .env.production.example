# Production template. Copy to a secret manager or an untracked .env.production.
# Never commit real credentials. Do not point this file at staging resources.

NODE_ENV=production

# Public HTTPS origin that serves the UI, /api, and /socket.io (Approach A).
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_API_URL=

POSTGRESQL_URL=postgresql://teamhub:REPLACE@postgres-host:5432/teamhub_prod
REDIS_URL=redis://:REPLACE@redis-host:6379

SESSION_TTL_DAYS=14
GUEST_SESSION_HOURS=4
ALLOW_DEMO_PERSONA_LOGIN=false
COOKIE_SECURE=true
COOKIE_DOMAIN=
TRUST_PROXY=true
SOCKET_IO_REDIS_REQUIRED=true
RUN_BACKGROUND_JOBS=true
TRUSTED_PROXY_IPS=REPLACE_WITH_PROXY_IPS
# AUTH_PROXY_SECRET=at-least-16-chars

STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=teamhub-prod
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_FORCE_PATH_STYLE=false

LOG_LEVEL=info
SQL_TRACE=false
