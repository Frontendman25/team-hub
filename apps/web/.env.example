NEXT_PUBLIC_API_URL=http://localhost:3200
API_INTERNAL_URL=http://localhost:3200
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Same-origin staging (Caddy): leave NEXT_PUBLIC_API_URL empty so sockets use the page origin.
# Set true only when Next sits behind a platform proxy that overwrites X-Forwarded-For (Vercel, nginx).
WEB_TRUST_PROXY=false
# Must match apps/api AUTH_PROXY_SECRET when Nest is not on loopback.
# AUTH_PROXY_SECRET=
