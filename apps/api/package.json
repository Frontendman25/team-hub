{
  "name": "@teamhub/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build": "nest build",
    "lint": "eslint -c ../../eslint.config.cjs \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint -c ../../eslint.config.cjs \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/migrate.js",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/infrastructure/database/seed.ts",
    "db:seed:staging-demo": "tsx src/seed-staging-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.8",
    "@node-rs/argon2": "^2.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.4.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.5",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.4.0",
    "pino": "^10.0.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.4.7",
    "redis": "^5.8.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/core": "^1.13.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^3.2.4"
  }
}
