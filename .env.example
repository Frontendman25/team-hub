# ─────────────────────────────────────────────────────────────────────────────
# Environment variable template
# Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
PORT=3200
NODE_ENV=development

FRONTEND_URL=http://localhost:3000
SESSION_TTL_DAYS=14
GUEST_SESSION_HOURS=4
# Default: true unless NODE_ENV=production. Keep false in any public deploy.
# ALLOW_DEMO_PERSONA_LOGIN=false
# COOKIE_SECURE defaults to true when NODE_ENV=production. Set false only for HTTP smoke tests.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
# TRUST_PROXY defaults to true in production (Express behind Caddy).
# SOCKET_IO_REDIS_REQUIRED defaults to true outside development. Do not disable in staging.
# RUN_BACKGROUND_JOBS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# Optional. If set (min 16 chars), Nest trusts X-Forwarded-For only when
# the Next proxy sends the matching x-teamhub-proxy-secret header.
# AUTH_PROXY_SECRET=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=teamhub
POSTGRES_PASSWORD=teamhub
POSTGRES_DB=teamhub
# Host port mapped by docker-compose.dev.yml (FS Project uses 5434; this avoids clashing)
POSTGRES_PORT=5435

# Inside Docker Compose network (api container → postgres service)
LOCAL_POSTGRESQL_URL=postgresql://teamhub:teamhub@postgres:5432/teamhub

# Host tools + Nest running on the machine (not inside Docker)
POSTGRESQL_URL=postgresql://teamhub:teamhub@localhost:5435/teamhub

# ── Redis (unread cache, presence, rate limits, BullMQ, Socket.IO adapter) ───
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
# Staging/production must use redis://:password@host:6379 and must not share this instance.

# ── Object storage (S3-compatible; local MinIO via db:up) ─────────────────────
# Browser uploads use presigned PUT. Never expose these keys to the client.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=teamhub
S3_ACCESS_KEY_ID=teamhub
S3_SECRET_ACCESS_KEY=teamhubminio
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
SQL_TRACE=true
