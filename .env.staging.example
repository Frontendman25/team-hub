# Copy to .env.staging and change every secret. Never commit .env.staging.
# Used by: docker compose --env-file .env.staging -f docker-compose.yml -f docker-compose.staging.yml

NODE_ENV=production
STAGING_HTTP_PORT=8080
STAGING_S3_PORT=9002

FRONTEND_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:8080
# Empty = browser Socket.IO uses the page origin (required for Approach A).
NEXT_PUBLIC_API_URL=

POSTGRES_USER=teamhub
POSTGRES_PASSWORD=change-me-staging-pg
POSTGRES_DB=teamhub_staging
POSTGRESQL_URL=postgresql://teamhub:change-me-staging-pg@postgres:5432/teamhub_staging

REDIS_PASSWORD=change-me-staging-redis
REDIS_URL=redis://:change-me-staging-redis@redis:6379

SESSION_TTL_DAYS=14
GUEST_SESSION_HOURS=4
ALLOW_DEMO_PERSONA_LOGIN=false
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=true
SOCKET_IO_REDIS_REQUIRED=true
RUN_BACKGROUND_JOBS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1,::ffff:127.0.0.1
# AUTH_PROXY_SECRET=

STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=teamhub-staging
S3_ACCESS_KEY_ID=teamhubstaging
S3_SECRET_ACCESS_KEY=change-me-staging-minio
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=info
SQL_TRACE=false
